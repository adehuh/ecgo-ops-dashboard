# Environment variable untuk deployment Vercel.
#
# Salin nilainya ke Vercel → Project → Settings → Environment Variables.
# JANGAN commit nilai aslinya; berkas ini hanya cetakan.

# WAJIB. Connection string Postgres terkelola.
# `sslmode=require` bukan opsional: Neon/Supabase menolak koneksi tanpa TLS, dan
# server/db.ts memakai keberadaan flag ini (atau env VERCEL) untuk menyalakannya.
DATABASE_URL=postgres://user:password@host.region.aws.neon.tech/dbname?sslmode=require

# Opsional — ambang heartbeat basi, dalam menit. Default 10.
# Dipakai bersama oleh sortir keparahan, filter STALE_HEARTBEAT, dan kolom
# is_stale, jadi mengubahnya di sini menggeser ketiganya sekaligus.
ECGO_STALE_MINUTES=10

# Opsional — berapa hop proxy yang boleh dipercaya untuk req.ip.
# Default 1 di Vercel (proxy platform berada tepat di depan fungsi).
# Jangan dinaikkan tanpa alasan: rate limit login dikunci pada req.ip, dan
# mempercayai lebih banyak hop berarti penyerang bisa mengarang IP lewat header.
TRUST_PROXY=1

# Dipasang Vercel sendiri, tidak perlu diisi manual:
#   NODE_ENV=production
#   VERCEL=1          -> pool database menyusut ke 1 koneksi/instance + TLS aktif

# Opsional — HANYA untuk deployment demo/penilaian.
# Menampilkan tombol akun demo di halaman masuk, seperti saat `npm run dev`.
# Tanpa variabel ini, build produksi tetap MEMBUANG blok itu dari bundel
# (bukan menyembunyikannya), jadi klaim di README tetap berlaku.
# Jangan pernah dipasang pada deployment yang memuat data sungguhan.
VITE_DEMO_ACCOUNTS=1
