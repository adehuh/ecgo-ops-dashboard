# Copy to .env. Matches docker-compose.yml defaults.
# Server-side only: this must never reach the client bundle. In Nuxt, any key that
# is NOT under runtimeConfig.public stays on the server — see nuxt.config.ts.
DATABASE_URL=postgres://ecgo:ecgo_dev_password@localhost:55432/ecgo_ops

# Cabinet is flagged "stale" when its heartbeat is older than this many minutes.
ECGO_STALE_MINUTES=10
